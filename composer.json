{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "artisan-toolbox/maintainer",
    "description": "Automated validation, quality assurance, versioning, and release workflows for Laravel packages and applications.",
    "keywords": [
        "artisan-toolbox",
        "automation",
        "cli",
        "github-releases",
        "laravel",
        "laravel-zero",
        "maintenance",
        "quality-assurance"
    ],
    "homepage": "https://github.com/artisan-toolbox/maintainer",
    "type": "project",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/artisan-toolbox/maintainer/issues",
        "source": "https://github.com/artisan-toolbox/maintainer"
    },
    "authors": [
        {
            "name": "Allan Mariucci Carvalho",
            "email": "allan@wss.group",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "laravel-zero/foundation": "^13.23",
        "laravel-zero/framework": "^13.0",
        "laravel/pint": "^1.30.4",
        "mockery/mockery": "^1.6.12",
        "pestphp/pest": "^5.0.3"
    },
    "autoload": {
        "psr-4": {
            "ArtisanToolbox\\Maintainer\\Contracts\\": "app/Contracts/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Commands\\": "app/Commands/",
            "App\\Foundation\\": "app/Foundation/",
            "App\\Providers\\": "app/Providers/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": [
        "builds/maintainer"
    ]
}
